{
  "cli": { "version": ">= 12.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "distribution": "internal",
      "environment": "development",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false }
    },
    "simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" }
    }
  }
}
