# Use a URL e a chave pública do MESMO projeto Supabase da plataforma web.
# Nunca use service_role, senha do banco ou secrets de funções.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Origem HTTPS definitiva do portal público, sem caminho.
EXPO_PUBLIC_WEB_URL=

# Identificadores próprios, registrados pelo responsável nas lojas.
RAFAH_IOS_BUNDLE_ID=
RAFAH_ANDROID_PACKAGE=
EAS_PROJECT_ID=
